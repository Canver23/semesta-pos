# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (OPSIONAL tapi sangat disarankan untuk production).
# Ambil dari: Supabase Dashboard → Settings → API → service_role
# RAHASIA — jangan commit atau share!
SUPABASE_SERVICE_ROLE_KEY=

# ── Keamanan sesi ─────────────────────────────────────────
# WAJIB di production. String acak minimal 16 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Kredensial login (HANYA di server, tanpa prefix NEXT_PUBLIC_) ──
# Nilai default (1234 / admin / admin123) HANYA berlaku di dev.
# Di production login akan ditolak bila variabel ini kosong.
KASIR_PIN=
ADMIN_USER=
ADMIN_PASS=
